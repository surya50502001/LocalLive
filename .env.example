# Copy to .env and fill in real values. Never commit .env.

# Database
DB_USER=locallive
DB_PASSWORD=change-me-strong-password
DB_NAME=locallive
DB_PORT=5432

# API
API_PORT=8080
WEB_PORT=80
WEB_ORIGIN=http://localhost

# JWT signing key (REQUIRED, at least 32 characters)
JWT_KEY=replace-with-a-long-random-secret-32-characters-min
JWT_ISSUER=LocalLive
JWT_AUDIENCE=LocalliveClient

# Map / navigation provider: google_maps | apple_maps | waze | osm | none
NAVIGATION_PROVIDER=google_maps

# Bootstrap admin account (created only on an empty database)
ADMIN_EMAIL=admin@locallive.app
ADMIN_PASSWORD=

# Seed demo data (dev only; keep false in production)
SEED_DEMO_DATA=false
